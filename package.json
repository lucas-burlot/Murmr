{
  "name": "murmr",
  "productName": "Murmr",
  "version": "1.0.0",
  "description": "Free, open-source voice dictation: hold a key, speak, and your text is pasted. A Wispr Flow alternative.",
  "main": "out/main/main.js",
  "author": "Lucas Burlot",
  "license": "MIT",
  "homepage": "https://github.com/lucas-burlot/Murmr",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucas-burlot/Murmr.git"
  },
  "bugs": "https://github.com/lucas-burlot/Murmr/issues",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.node.json && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@fugood/whisper.node": "^1.2.0-rc.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "io.github.murmr.app",
    "productName": "Murmr",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json",
      "!node_modules/@fugood/node-whisper-wasm{,/**}",
      "!node_modules/@fugood/node-whisper-*-{cuda,vulkan,snapdragon}{,/**}"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "*.png"
        ]
      }
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Murmr uses the microphone to transcribe your voice.",
        "LSUIElement": true
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "Lucas Burlot",
      "executableName": "murmr",
      "synopsis": "Free, open-source voice dictation"
    },
    "artifactName": "Murmr-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "lucas-burlot",
      "repo": "Murmr",
      "releaseType": "draft"
    }
  },
  "allowScripts": {
    "@fugood/whisper.node": false
  }
}
